#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Distribution signing must be supplied by the release environment. These
// settings intentionally do not fall back to a development certificate.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = $(LAB_WORKSPACE_APPLE_TEAM_ID)
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = $(LAB_WORKSPACE_APPLE_PROFILE_NAME)
