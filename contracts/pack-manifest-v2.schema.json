{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/pack-manifest-v2.schema.json",
  "title": "pack-manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "calculation",
        "protocol",
        "bundle"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requires_engine": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "permission_level": {
      "enum": [
        "declarative_only",
        "trusted_builtin",
        "external_python"
      ]
    },
    "required_primitives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "kind",
    "title",
    "requires_engine",
    "files",
    "permission_level",
    "required_primitives",
    "signed_by",
    "author"
  ]
}
