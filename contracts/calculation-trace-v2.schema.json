{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/calculation-trace-v2.schema.json",
  "title": "calculation-trace-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "calculation_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_ref": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executor_id": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "primitive_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "primitive_code_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "executor_id",
        "python_version",
        "primitive_versions",
        "platform"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "value",
          "unit"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "op": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "substitution": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "intermediates": {
            "type": "object"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "key",
              "value",
              "unit"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "value": {"type": ["string", "number", "integer", "boolean", "null"]},
                "unit": {"type": ["string", "null"]},
                "source_ref": {"type": ["string", "null"]}
              },
              "required": ["key", "value", "unit"]
            }
          }
        },
        "required": [
          "seq",
          "op",
          "expression",
          "substitution",
          "inputs",
          "intermediates",
          "result",
          "warnings"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "value",
          "unit"
        ]
      }
    },
    "source_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "validation_level": {
            "enum": [
              "verified",
              "quick_checked",
              "unknown"
            ]
          }
        },
        "required": [
          "asset_id",
          "sha256"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_confirmed": {
      "type": "boolean"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "primitive_build_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "user_approval",
            "trusted_builtin"
          ]
        }
      },
      "required": [
        "reference",
        "kind"
      ]
    },
    "ai_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "report_extraction",
              "model_suggestion",
              "tool_result"
            ]
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "values": {
            "type": "object"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_confirmed": {
            "type": "boolean"
          },
          "confirmation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmed_at_utc": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "user_confirmed"
        ]
      }
    },
    "recalculation_parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decimal_precision": {
          "type": "integer",
          "minimum": 1
        },
        "rounding": {
          "type": "string",
          "minLength": 1
        },
        "float_inputs_allowed": {
          "const": false
        }
      },
      "required": [
        "decimal_precision",
        "rounding",
        "float_inputs_allowed"
      ]
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "runtime",
        "platform"
      ]
    },
    "quantification_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_asset_kind": {
          "const": "raw"
        },
        "source_immutable": {
          "const": true
        },
        "generated_pixels_used": {
          "const": false
        },
        "channel_index": {
          "type": "integer",
          "minimum": 0
        },
        "channel_name": {
          "type": "string",
          "minLength": 1
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "signal_roi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        "background_roi": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "background_method": {
          "enum": [
            "none",
            "mean_subtract"
          ]
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_asset_kind",
        "source_immutable",
        "generated_pixels_used",
        "channel_index",
        "channel_name",
        "image_width",
        "image_height",
        "bit_depth",
        "signal_roi",
        "background_roi",
        "background_method",
        "approval_ref",
        "approved_at_utc",
        "reviewer"
      ]
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "calculation_id",
    "pack_ref",
    "engine",
    "inputs",
    "steps",
    "outputs",
    "source_assets",
    "warnings",
    "user_confirmed"
  ]
}
