{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/image-calculation-trace-v2.schema.json",
  "title": "Lab Workspace image CalculationTrace v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trace_id": { "type": "string", "minLength": 1 },
    "calculation_id": { "type": "string", "minLength": 1 },
    "pack_ref": { "const": "lab-workspace.image-roi@1.0.0" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executor_id": { "const": "trusted-original-pixel-arithmetic" },
        "python_version": { "type": "string", "minLength": 1 },
        "primitive_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "primitive_code_sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "platform": { "type": "string", "minLength": 1 }
      },
      "required": ["executor_id", "python_version", "primitive_versions", "primitive_code_sha256", "platform"]
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "source_ref": { "type": ["string", "null"] }
        },
        "required": ["key", "value", "unit", "source_ref"]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": { "type": "integer", "minimum": 1, "maximum": 2 },
          "op": { "enum": ["image.compute_roi_pixels@1", "image.background_correct@1"] },
          "expression": { "type": "string", "minLength": 1 },
          "substitution": { "type": "string", "minLength": 1 },
          "inputs": { "type": "object" },
          "intermediates": { "type": "object" },
          "result": { "$ref": "#/$defs/result" },
          "results": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/result" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["seq", "op", "expression", "substitution", "inputs", "intermediates", "result", "results", "warnings"]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/result" }
    },
    "user_confirmed": { "type": "boolean" },
    "source_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "validation_level": { "enum": ["verified", "quick_checked"] }
        },
        "required": ["asset_id", "sha256", "validation_level"]
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "primitive_build_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "execution_context": { "type": "object" },
    "ai_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": { "enum": ["report_extraction", "model_suggestion", "tool_result"] },
          "tool_call_id": { "type": ["string", "null"] },
          "model_id": { "type": ["string", "null"] },
          "values": { "type": "object" },
          "confidence": { "type": ["string", "null"] },
          "user_confirmed": { "type": "boolean" },
          "confirmation_ref": { "type": ["string", "null"] },
          "confirmed_at_utc": { "type": ["string", "null"] }
        },
        "required": ["source", "user_confirmed"]
      }
    },
    "recalculation_parent_id": { "type": ["string", "null"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "kind": { "const": "user_approval" }
      },
      "required": ["reference", "kind"]
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decimal_precision": { "type": "integer", "minimum": 1 },
        "rounding": { "type": "string", "minLength": 1 },
        "float_inputs_allowed": { "const": false }
      },
      "required": ["decimal_precision", "rounding", "float_inputs_allowed"]
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["runtime", "platform", "dependencies"]
    },
    "quantification_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_asset_kind": { "const": "raw" },
        "source_immutable": { "const": true },
        "generated_pixels_used": { "const": false },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "channel_index": { "type": "integer", "minimum": 0 },
        "channel_name": { "type": "string", "minLength": 1 },
        "image_width": { "type": "integer", "minimum": 1 },
        "image_height": { "type": "integer", "minimum": 1 },
        "bit_depth": { "type": "integer", "enum": [8, 16] },
        "page_index": { "type": "integer", "minimum": 0 },
        "page_count": { "type": "integer", "minimum": 1 },
        "signal_roi": { "$ref": "#/$defs/roi" },
        "background_roi": { "anyOf": [{ "$ref": "#/$defs/roi" }, { "type": "null" }] },
        "background_method": { "enum": ["none", "mean_subtract"] },
        "approval_ref": { "type": "string", "minLength": 1 },
        "approved_at_utc": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 1 }
      },
      "required": ["source_asset_kind", "source_immutable", "generated_pixels_used", "source_sha256", "channel_index", "channel_name", "image_width", "image_height", "bit_depth", "page_index", "page_count", "signal_roi", "background_roi", "background_method", "approval_ref", "approved_at_utc", "reviewer"]
    }
  },
    "required": ["schema_version", "content_sha256", "trace_id", "calculation_id", "pack_ref", "engine", "inputs", "steps", "outputs", "source_assets", "warnings", "errors", "user_confirmed", "created_at_utc", "primitive_build_versions", "execution_context", "approval", "ai_provenance", "recalculation_parent_id", "precision", "execution_environment", "quantification_context"],
  "$defs": {
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["x", "y", "width", "height"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "unit": { "type": ["string", "null"] },
        "source_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["key", "value", "unit", "source_ref"]
    }
  }
}
