{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/sync-event-v2.schema.json",
  "title": "sync-event-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "vault_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "lamport": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_kind": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "action": {
      "enum": [
        "create",
        "patch",
        "append",
        "tombstone",
        "resolve"
      ]
    },
    "payload": {
      "type": "object"
    },
    "sha_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "vault_id",
    "device_id",
    "seq",
    "lamport",
    "event_id",
    "entity_kind",
    "entity_id",
    "base_revision",
    "action",
    "payload",
    "sha_refs",
    "created_at_utc"
  ]
}
