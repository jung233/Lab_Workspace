{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/forms-v2.schema.json",
  "title": "forms-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "widget": {
            "enum": [
              "text",
              "decimal",
              "integer",
              "choice",
              "file",
              "table",
              "sample",
              "checkbox"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "label",
          "widget",
          "required"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "show_trace_button": {
            "const": true
          }
        },
        "required": [
          "key",
          "label",
          "show_trace_button"
        ]
      }
    },
    "warning": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "title",
    "fields",
    "outputs",
    "warning"
  ]
}
