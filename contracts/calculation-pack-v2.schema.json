{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/calculation-pack-v2.schema.json",
  "title": "calculation-pack-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "calculation"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "disabled"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "decimal",
              "integer",
              "text",
              "table",
              "asset_ref",
              "sample_ref",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "kind",
          "required"
        ]
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*@[0-9]+$"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "params": {
            "type": "object"
          }
        },
        "required": [
          "step_id",
          "op",
          "inputs",
          "params"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "from_ref": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "from_ref",
          "unit"
        ]
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expression_ref": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warn",
              "block"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "expression_ref",
          "severity",
          "message"
        ]
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object"
          },
          "expected": {
            "type": "object"
          },
          "tolerance": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "inputs",
          "expected"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by_user": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "approved_by_user",
        "warnings"
      ]
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "kind",
    "status",
    "title",
    "inputs",
    "pipeline",
    "outputs",
    "quality_gates",
    "tests",
    "review"
  ]
}
