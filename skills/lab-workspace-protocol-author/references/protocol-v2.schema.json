{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labworkspace.local/contracts/protocol-v2.schema.json",
  "title": "protocol-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "archived"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "enum": [
              "sop",
              "user",
              "history",
              "ai_suggestion",
              "unknown"
            ]
          }
        },
        "required": [
          "asset_id",
          "sha256",
          "origin"
        ]
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "decimal",
              "integer",
              "text",
              "date",
              "choice",
              "sample_ref",
              "asset_ref",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {}
        },
        "required": [
          "key",
          "kind",
          "required"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "action",
              "wait",
              "measure",
              "calculate",
              "image",
              "record",
              "decision",
              "repeat",
              "sample",
              "review"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expected_seconds": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "source": {
                "enum": [
                  "sop",
                  "user",
                  "historical",
                  "ai_estimate",
                  "unknown"
                ]
              },
              "source_quote": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "expected_seconds",
              "source"
            ]
          },
          "captures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string"
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "key",
                "kind",
                "required"
              ]
            }
          },
          "tool_pack_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "human_gate": {
            "type": "boolean"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "quote": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "origin": {
                    "enum": [
                      "sop",
                      "user",
                      "history",
                      "ai_suggestion",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "asset_id",
                  "sha256",
                  "origin"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "repeat_max": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000
          },
          "params": {
            "type": "object"
          },
          "output_bindings": {
            "type": "object"
          }
        },
        "required": [
          "step_id",
          "kind",
          "title",
          "depends_on",
          "duration",
          "human_gate"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by_user": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "approved_by_user",
        "warnings"
      ]
    }
  },
  "required": [
    "schema_version",
    "protocol_id",
    "version",
    "title",
    "status",
    "sources",
    "variables",
    "steps",
    "review"
  ]
}
